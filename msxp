#!/bin/sh
# msxp for macOS, Linux and Git Bash: ./msxp help  (uses .venv once "msxp install" has created it)
here=$(cd "$(dirname "$0")" && pwd)
for python in "$MSXP_PYTHON" "$here/.venv/bin/python" "$here/.venv/Scripts/python.exe" python3 python; do
  if [ -n "$python" ] && command -v "$python" >/dev/null 2>&1; then
    exec "$python" "$here/tools/msxp.py" "$@"
  fi
done
echo "Python 3.11 or newer is required: https://www.python.org/downloads/" >&2
exit 1
