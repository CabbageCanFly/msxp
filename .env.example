# Your local settings and secrets. `msxp install` copies this file to .env; edit .env, never commit it.
# Every line is optional: remove the leading # to change a default.

# --- msxp settings ---
# MSXP_DATABASE=private/msxp/tracker.sqlite3   # your tracker database (created by: msxp setup)
# MSXP_PORT=8765                              # your website (msxp tracker / msxp api)
# MSXP_ADMIN_PORT=8766                        # admin portal (msxp admin)
# MSXP_DEMO_PORT=8890                         # fictional demo (msxp demo)
# MSXP_DASHBOARD_PORT=8767                    # operator dashboard (msxp dashboard)
# MSXP_WORKERS=2                              # streams captured at the same time (1-8)

# --- Your server (optional, for: msxp server admin / logs / health) ---
# MSXP_SERVER=root@203.0.113.7               # SSH login of the server running msxp
# MSXP_SERVER_DIR=/opt/msxp/app               # where the project is on the server
# MSXP_SERVER_USER=msxp                       # the server's service user (owns the database)

# --- Twitch (optional) ---
# Official Twitch status (who is live, and in which category): create an application at
# https://dev.twitch.tv/console/apps and paste its Client ID and Secret. msxp passes --twitch-status when both are set.
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
# Optional legacy alternative when no client secret is configured:
# TWITCH_ACCESS_TOKEN=your_manually_generated_token
# Optional Turbo playback (fewer ads in captured video): paste only the browser auth-token, without OAuth/header text.
# TWITCH_PLAYBACK_TOKEN=your_browser_token
