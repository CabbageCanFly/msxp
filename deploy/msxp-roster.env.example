# /etc/msxp/roster.env: root:msxp 0640. Choose an existing, reviewed roster DB.
# This deliberately nonexistent name prevents accidental use before path review.
MSXP_DATABASE=/opt/msxp/app/private/vps/CHOOSE-REVIEWED-DATABASE.sqlite3
# systemd expands these into separate arguments; no shell is invoked.
# Keep the initial trial bounded. Blank only after separate production approval.
MSXP_CAPTURE_LIMITS=--stop-after-seconds 600 --exit-after-capture
# Optional: set to --twitch-status after checking /etc/msxp/msxp.env credentials.
MSXP_TWITCH_STATUS=
# Destructive evidence expiry: leave blank until separate retention approval.
MSXP_RETENTION=
