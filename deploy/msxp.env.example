# /etc/msxp/msxp.env (root:msxp, mode 0640). Never commit real values.
# Exact frontend origin allowed to read the API; one origin per --cors-origin.
MSXP_FRONTEND_ORIGIN=https://msxp.pages.dev
# Optional official Twitch live status (--twitch-status); app access token is maintained in memory.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
