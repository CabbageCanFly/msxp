# /etc/msxp/alert.env, root:msxp 0640. `msxp alert on` creates it from this file and asks for the webhook.
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Blank: stuck streams are only written to the log (msxp logs alert).
MSXP_ALERT_WEBHOOK=
# Minutes a live stream may show its HUD without a usable reading before it counts as stuck.
MSXP_ALERT_MINUTES=30
# Optional per-streamer increases; other streams keep the default above. Logins ignore case.
# MSXP_ALERT_STREAM_MINUTES=Streamer_A=90,Streamer_B=120
MSXP_ALERT_STREAM_MINUTES=
