# Explicitly reviewed authoritative schema-11 database; the Windows DB is separate.
MSXP_DATABASE=/opt/msxp/app/private/production-20261021/tracker.sqlite3
MSXP_PUBLICATION_CACHE=/opt/msxp/app/private/publication-cache/publications.sqlite3
MSXP_RUNTIME_STATE=/opt/msxp/app/private/publication-cache/capture-runtime.json
# Optional; credentials remain in /etc/msxp/msxp.env. This affects only msxp-api.
MSXP_TWITCH_STATUS=
# Capture bounds remain those chosen in roster.env/production overrides; retention is msxp-retention.timer.
